{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": ".script-build",
    "rootDir": ".",
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": [
    "scripts/regenerate-anker-annotations.ts",
    "lib/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".test-build",
    ".script-build"
  ]
}
