LLM_PROVIDER=doubao           # doubao | anthropic | openai | deepseek

DOUBAO_LLM_API_KEY=
DOUBAO_LLM_MODEL=doubao-1-5-pro-32k-250115
DOUBAO_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=           # 可选：接 Anthropic 镜像

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=              # 可选：例如 https://api.openai-proxy.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-reasoner

DOUBAO_TTS_API_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-1.0
DOUBAO_TTS_VOICE=zh_female_shuangkuaisisi_moon_bigtts
DOUBAO_TTS_CLUSTER=volcano_icl
# 默认使用新版 X-Api-Key 鉴权。仅旧版控制台项目需要启用 legacy，并配置 APP_ID / ACCESS_KEY。
# DOUBAO_TTS_AUTH_MODE=legacy
# DOUBAO_TTS_APP_ID=
# DOUBAO_TTS_ACCESS_KEY=
DOUBAO_ASR_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
DOUBAO_ASR_FLASH_RESOURCE_ID=volc.bigasr.auc_turbo
DOUBAO_ASR_STREAM_RESOURCE_ID=volc.bigasr.sauc.duration
# DOUBAO_ASR_STREAM_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# Cloudflare 生产环境的实时识别走 worker 层 WebSocket 代理，这个资源 ID 需要与流式接口匹配。
# 本地开发流式字幕代理。npm run dev 默认会启动 ws://localhost:3001/asr/stream。
# LOCAL_ASR_STREAM_PORT=3001
# NEXT_PUBLIC_LOCAL_ASR_WS_URL=ws://localhost:3001/asr/stream

# —— Supabase (PostgreSQL database) ——
# Get these from https://app.supabase.com → your project → Settings → API
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AUTH_COOKIE_SECRET=

# —— 如果 Node 所在网络无法直连 OpenAI/Anthropic ——
# 设置 HTTP/HTTPS 代理地址（Clash/Surge/V2Ray 等本地代理通常是 http://127.0.0.1:7890）
HTTPS_PROXY=
HTTP_PROXY=
